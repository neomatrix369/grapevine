# Copy to .env.local. Never commit .env.local.

# Supabase (do not apply the migration until these are filled)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Cognee Cloud (server-only; base URL and tenant from the Cognee Cloud API Keys page)
COGNEE_API_KEY=
COGNEE_BASE_URL=
COGNEE_TENANT_ID=
COGNEE_DATASET=grapevine

# LLM for graph extraction (ingest only; the app does not need it)
LLM_API_KEY=
